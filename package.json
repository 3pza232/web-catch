{
  "name": "web-catch",
  "version": "0.3.2",
  "description": "Fetch web pages as clean Markdown, search the web, or serve both as an MCP server.",
  "type": "module",
  "bin": {
    "web-catch": "bin/cli.mjs"
  },
  "exports": {
    ".": "./lib/page.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "scripts",
    "test",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node test/smoke.mjs",
    "test:live": "node test/smoke.mjs --live",
    "test:mcp": "node test/mcp.mjs"
  },
  "keywords": [
    "cli",
    "mcp",
    "markdown",
    "readability",
    "web-scraping",
    "deepseek"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mozilla/readability": "^0.5.0",
    "linkedom": "^0.18.12",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  }
}
